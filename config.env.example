LLM_API_KEY=your_deepseek_api_key
TRANSCRIPTIONS_DATABASE_URL=postgres://postgres:SUASENHA@192.168.1.2:5432/roteiros_ab7?sslmode=disable
COMMENTS_DATABASE_URL=postgres://postgres:SUASENHA@192.168.1.2:5432/answer_comments?sslmode=disable
CLIENT_SECRET_FILE=data/client_secret.json
MEMBERS_CSV_FILE=data/members.csv
TOKEN_FILE=data/token.json

# LLM Configuration (DeepSeek)
LLM_ANALYSIS_MODEL=deepseek-v4-flash
LLM_GENERATION_MODEL=deepseek-v4-flash

# LLM Prompts
# Use {{COMMENT}}, {{TITLE}}, {{DESCRIPTION}}, {{TRANSCRIPT}}, {{HISTORY}}, {{CONSISTENCY}}, {{PROFILE}}, {{DATE_CONTEXT}} as placeholders
PROMPT_ANALYSIS="Você é um classificador de comentários feitos no youtube. ... {{DATE_CONTEXT}} Comentário que deve ser analisado: \"{{COMMENT}}\""
PROMPT_POSITIVE_ANSWER="Você é o meu assistente e responde às mensagens que os inscritos do meu canal no Youtube me enviam. ... O comentário que você deve responder é este: \"{{COMMENT}}\" ... O título do vídeo: \"{{TITLE}}\" ... A descrição: \"{{DESCRIPTION}}\" {{TRANSCRIPT}} {{HISTORY}} {{CONSISTENCY}} {{PROFILE}} {{MEMBER_NOTICE}} {{DATE_CONTEXT}}"
PROMPT_NEGATIVE_ANSWER="Você é o meu assistente e responde às mensagens que os inscritos do meu canal no Youtube me enviam. ... O comentário que você deve responder é este: \"{{COMMENT}}\" ... O título do vídeo: \"{{TITLE}}\" {{TRANSCRIPT}} {{DESCRIPTION}} {{HISTORY}} {{CONSISTENCY}} {{PROFILE}} {{MEMBER_NOTICE}} {{DATE_CONTEXT}}"

# Use {{COMMENT}}, {{EXISTING_FACTS}} as placeholders
PROMPT_EXTRACT_PROFILE="Você analisa um comentário de YouTube para extrair fatos DURÁVEIS e ESPECÍFICOS sobre a pessoa que comentou — coisas que a distinguem de outros inscritos do canal, úteis para personalizar respostas futuras (ex: profissão, denominação/igreja específica, cidade/região, uma dúvida teológica recorrente, uma situação de vida concreta mencionada). NÃO extraia coisas óbvias pelo contexto do canal (é um canal cristão protestante em português) como \"é cristão\", \"fala português\", \"assiste ao canal\", nem opiniões/elogios/reações passageiras ao vídeo. Na dúvida se o fato é específico o suficiente, NÃO extraia. Fatos já conhecidos sobre esta pessoa: {{EXISTING_FACTS}} Comentário: \"{{COMMENT}}\" Responda estritamente em JSON como um array de strings com os fatos NOVOS (que ainda não estão na lista acima). Se não houver fatos novos, específicos e duráveis, responda []."
